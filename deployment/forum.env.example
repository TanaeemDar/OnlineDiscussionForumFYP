# Install as /etc/forum/forum.env with mode 0600. Replace placeholders.
AllowedHosts=forum.example.com
DataDirectory=/var/lib/forum
ConnectionStrings__DefaultConnection="Data Source=/var/lib/forum/forum.db;Foreign Keys=True;Default Timeout=30"
# Supply only during initial migration, then remove these credentials.
Admin__UserName=ForumAdmin
Admin__Email=admin@example.com
Admin__Password=replace-with-a-strong-unique-password
Email__Mode=Disabled
