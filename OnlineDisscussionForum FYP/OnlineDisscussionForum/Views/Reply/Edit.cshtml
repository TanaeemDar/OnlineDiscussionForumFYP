@model ReplyEditModel
<div class="container body-content">
<h2>Edit reply</h2>
<form method="post" asp-action="Edit" asp-route-id="@Model.Id" enctype="multipart/form-data">
<div asp-validation-summary="All" class="text-danger"></div>
<input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" />
<div class="form-group"><label asp-for="Content"></label><textarea asp-for="Content" class="form-control" rows="10"></textarea><span asp-validation-for="Content" class="text-danger"></span></div>
<button class="btn btn-primary" type="submit">Save changes</button>
</form></div>
